package boogy:platform@0.1.0;

interface store {
    // -- Typed values --
    variant value {
        null,
        text(string),
        integer(s64),
        real(f64),
        blob(list<u8>),
        boolean(bool),
    }

    /// Errors a store operation can fail with. The `string` payload is
    /// for human consumption only — programmatic discrimination should
    /// use the variant arm. Mirrors peer.wit's `fetch-error`.
    variant store-error {
        quota-exceeded(string),
        not-found(string),
        conflict(string),
        constraint-violation(string),
        invalid-argument(string),
        unsupported(string),
        timeout(string),
        version-mismatch(string),
        /// Ambiguous commit (`commit_unknown_result`): the write MAY or MAY NOT
        /// have been applied. Do NOT blindly retry (could double-apply) —
        /// reconcile state first. → HTTP 409 (ambiguous-commit; distinct from a
        /// clean retryable conflict). The message body carries the distinction.
        commit-unknown(string),
        /// Transient: too many concurrent transactions; retry later. → HTTP 503.
        resource-exhausted(string),
        /// The transaction was rolled back because a participant failed. NOT a
        /// serialization conflict and NOT retryable — re-running would re-execute
        /// the participant that failed. → HTTP 409.
        poisoned(string),
        /// The transaction exhausted its retry attempts against a contended
        /// row. Transient: the caller should retry the request. → HTTP 503.
        too-contended(string),
        /// What the request referred to is no longer there, and no retry or
        /// adjustment will bring it back — today, a ranked listing whose
        /// ordering has been rebuilt and reclaimed while the caller was paging
        /// it. → HTTP 410. Distinct from `not-found`, which is about a thing
        /// that never existed or is not yours: this one DID exist and the
        /// caller was reading it.
        gone(string),
        internal(string),
    }

    record column {
        name: string,
        val: value,
    }

    record row {
        columns: list<column>,
    }

    // One row's update in a batch `update-many`: the primary key + the columns to set.
    record row-update {
        id: u64,
        columns: list<column>,
    }

    // -- Filtering --
    enum filter-op {
        eq,
        neq,
        gt,
        gte,
        lt,
        lte,
        like,
        not-like,
        is-null,
        is-not-null,
        in,
    }

    record filter {
        column: string,
        op: filter-op,
        val: value,
        /// Only used when op == in. Contains the set of values to match against.
        in-values: option<list<value>>,
    }

    // -- Sorting & Pagination --
    enum sort-dir { asc, desc }

    record sort-by {
        column: string,
        dir: sort-dir,
    }

    /// ONE ordering term: a column, or an aggregate over a related table.
    ///
    /// `ORDER BY` is one clause, so it travels as one list of one type. It used
    /// retired-spelling: `find-options.sort` and
    /// `find-options.order-by-agg` were both retired 2026-08-17 into this
    /// one `order-term` list. Kept because the shape below is only
    /// defensible against the shape it replaced.
    /// to be three fields — `find-options.sort`, `find-options.order-by-agg`
    /// and `aggregate-options.order-by` — with three names, two records and two
    /// cardinalities for the same idea. Every construction site had to name
    /// ordering fields it did not care about, and a reader of one could not
    /// tell whether the other was consulted; the SDK's `fetch-group-page`
    /// checked the aggregate field directly and silently refused every ranked
    /// page once its only writer went away.
    ///
    /// What each side ACCEPTS is not the type's job and is stated where it is
    /// enforced: a row query takes at most one aggregate term, a grouped query
    /// takes aggregate terms only.
    variant order-term {
        column(sort-by),
        aggregate(agg-sort),
    }

    record page {
        limit: u32,
        offset: u32,
    }

    record find-options {
        filters: list<filter>,
        page: option<page>,
        /// OR-of-AND clause layered on top of `filters`. A row matches when
        /// ALL(filters) AND (or-groups is empty OR ANY(group: ALL(group))).
        /// Empty `or-groups` (the default) is exactly the filters-only
        /// behavior — fully backward compatible.
        or-groups: list<list<filter>>,
        /// Skip computing `total-count` (the host answers `none`). Set by
        /// callers that discard the total — keyset/`fetch-page`, `fetch-all`,
        /// `fetch-one` — so the host can avoid the count entirely on the
        /// index-walk fast path, where it would otherwise be a separate count
        /// over the table for a value nobody reads. Defaults to `false` (the
        /// total is computed) — counts and total-bearing fetches leave it off.
        ///
        /// It does NOT decide whether a caller can tell a full page from the
        /// end of a listing: `find-result.has-more` answers that under either
        /// value, so declining the total never costs completeness.
        skip-total: bool,
        /// How to order these rows: column terms, and at most ONE aggregate
        /// term — "best first", where "best" is a total the children carry.
        ///
        /// The relation behind an aggregate term comes from the child's
        /// declared foreign key, so nothing here names it. More than one
        /// aggregate term is REFUSED at the boundary rather than made
        /// unrepresentable by the type: the cardinality is a property of what
        /// the engine can serve, and a reader should find it stated where it is
        /// enforced instead of inferring it from an `option<>`.
        order-by: list<order-term>,
        // Continue a ranked listing. Opaque, and the same contract the group
        // cursor has: it names the GENERATION of the ordering, not just a
        // position, so a page taken after a refresh continues the list it
        // started in.
        group-cursor: option<string>,
        /// Counters to merge into the returned rows — names of live
        /// counter columns on this table. Empty (the default every
        /// existing construction site keeps) merges NOTHING: a counter's
        /// value never arrives in a row unless named here. Naming any one
        /// counter merges every live counter column on the table (per-table
        /// granularity, not per-column — accepted, see the SDK's
        /// `QueryArgs::with_counter` doc).
        counters: list<string>,
    }

    record find-result {
        rows: list<row>,
        /// The number of rows matching the query, ignoring the page — `none`
        /// when `skip-total` asked the host not to compute one.
        ///
        /// An `option` rather than a bare `u64` because the two states a bare
        /// `u64` collapsed are different answers: `0` meant BOTH "no rows
        /// matched" and "I did not count". Nothing at the call site could tell
        /// them apart, so a declined total read as an empty table.
        total-count: option<u64>,
        /// Whether more matching rows follow this page.
        ///
        /// Set by the HOST, which is the only party that can know it. A page
        /// limit is clamped to the host's own per-call row ceiling, and the
        /// clamp is silent — so a caller comparing the rows it got against the
        /// limit it asked for cannot distinguish "the ceiling cut this page"
        /// from "the listing ended here", and a listing that guesses the second
        /// stops early while reading as a complete answer.
        ///
        /// It is meaningful under `skip-total` too: it is the page's own
        /// property, not a fact derived from a count.
        ///
        /// Direction of any inexactness is fixed: it may be `true` when the
        /// next page turns out to be empty, never `false` while rows remain.
        /// An extra request is a cost; a truncation is a wrong answer.
        has-more: bool,
        // The token that continues a ranked listing, when more follows.
        next-group-cursor: option<string>,
    }

    // One independent query in a batch `find-many`: a table + the same
    // find-options a single `find` takes.
    record find-query {
        table: string,
        options: find-options,
    }

    // -- Aggregates --

    // The aggregate functions, with the meanings SQL gives them.
    //
    // `count-all` is `COUNT(*)`: it counts rows and needs no column. The others
    // read one column and IGNORE rows whose value is null, so an aggregate over
    // a column that is null everywhere is the same as one over no rows at all.
    enum agg-func { count-all, sum, avg, min, max }

    // One aggregate to compute. `column` is required for every function except
    // `count-all`, where it is ignored. (`kind` rather than `func`, which is a
    // reserved word here, and rather than `op`, which `agg-filter` already uses
    // for its comparison operator.)
    record agg-spec {
        kind: agg-func,
        column: option<string>,
    }

    // A predicate applied AFTER aggregation, against an aggregate's own value —
    // SQL's `HAVING`. Distinct from `filter`, which selects the rows that go
    // INTO the aggregate.
    record agg-filter {
        agg: agg-spec,
        op: filter-op,
        val: value,
    }

    // Ordering by an aggregate's value rather than by a column.
    record agg-sort {
        agg: agg-spec,
        dir: sort-dir,
    }

    record aggregate-options {
        // Selects the rows that feed the aggregates.
        filters: list<filter>,
        or-groups: list<list<filter>>,
        // Empty = ungrouped, which returns exactly ONE group whose `keys` is
        // empty — matching SQL, where `SELECT sum(x) FROM t` over an empty
        // table still returns one row.
        group-by: list<string>,
        aggregates: list<agg-spec>,
        having: list<agg-filter>,
        /// How to order the GROUPS. Aggregate terms only — a grouped result has
        /// no columns to order by beyond its keys, and ordering by a group key
        /// is not served today, so a column term is refused at the boundary.
        order-by: list<order-term>,
        page: option<page>,
        // Continue a ranked traversal an earlier page started, instead of
        // re-reading whatever ordering is current now.
        //
        // Opaque: a token the platform minted and the caller hands back, the
        // same contract row cursors have. It names the GENERATION of the
        // ordering, which is the one thing an offset cannot — a ranked list is
        // keyed on a value the rows keep changing, so `offset 10` against a
        // rebuilt ordering repeats and skips entries.
        //
        // `none` starts a traversal. `some` pins it; if that generation has
        // been reclaimed the read is refused rather than quietly answered from
        // a different one.
        group-cursor: option<string>,
        // Whether the caller intends to WALK this ordering rather than take one
        // look at the top of it.
        //
        // Both ask the same question; only one needs the answer to stay put.
        // Pinning an ordering means publishing it, and publishing costs writes
        // on a read path — so a plain "top 10" must not pay for a continuation
        // nobody is going to use, and a listing that will be paged must not be
        // handed pages that disagree. This is the caller saying which they are,
        // and it is a statement of intent, not a choice of mechanism: the
        // platform still decides whether anything is materialised and when.
        want-group-cursor: bool,
    }

    // One group. `keys` is positional against `group-by`; `values` positional
    // against `aggregates`.
    //
    // A `none` value is SQL NULL, and the distinction from `some(integer(0))`
    // is load-bearing: `sum` over no rows is NULL, while `count-all` over no
    // rows is 0. Collapsing the two would make "nothing matched" and "the total
    // happens to be zero" the same answer.
    record group-row {
        keys: list<value>,
        values: list<option<value>>,
    }

    record aggregate-result {
        groups: list<group-row>,
        // The token that continues THIS traversal, when more groups follow.
        //
        // Present only for a ranked, limited, grouped query — the shape that
        // has an ordering to be coherent about. An ungrouped total has nothing
        // to continue, so this is `none` rather than a token that means
        // nothing.
        next-group-cursor: option<string>,
    }

    // -- Schema management --
    enum column-type { text, integer, real, blob, boolean }

    enum cascade-action {
        no-action,
        restrict,
        cascade,
        set-null,
    }

    record foreign-key {
        references-table: string,
        references-column: string,
        on-delete: cascade-action,
        on-update: cascade-action,
    }

    record column-def {
        name: string,
        col-type: column-type,
        // False = the column must always hold a value, and this is ENFORCED on
        // every write path, not merely recorded:
        //
        // - A write that CREATES a row (`insert`, `insert-many`, and the
        //   row-creating arm of `upsert` / `upsert-increment`) must supply the
        //   column. Both an explicitly supplied `value.null` and a plain
        //   omission are refused with `constraint-violation`.
        // - A write that AMENDS a row (`update`, `update-many`, `update-where`,
        //   and the update arm of either upsert) is a change set: an absent
        //   column means "leave it alone", so only an explicit null is refused.
        //
        // Omission is refused because it is not the same as a zero and not the
        // same as absence either — it is both at once. A row stored without a
        // value for a column reads that column back as the type's zero value,
        // but no index entry was written for it, so the same row is invisible to
        // any indexed query over that column. Present to a lookup, absent to a
        // seek, with nothing saying so.
        //
        // Consequence at the call site, and it is a real cost: `upsert-increment`
        // and `upsert` must have `key ∪ columns.always ∪ columns.on-insert`
        // (plus the counter) cover every non-nullable column that has no
        // default, because the first call for a key is the one that creates
        // the row. If a column has a sensible STATIC starting value, give it a
        // `default` — that is the cheap fix, and unlike either column list it
        // does not overwrite the column on every later call. If the value is
        // COMPUTED at call time (a timestamp, a derived id), `on-insert` is
        // the fix instead: written only by the row-creating call, never
        // rewritten after. Reach for `always` only when the value must
        // genuinely change on every call.
        //
        // Two exemptions, each because the column cannot end up value-less: a
        // column with a `default` (the engine materializes it into the row when
        // the write omits it) and a `counter` column (its value lives in its own
        // cell, and the row slot is left empty on purpose).
        nullable: bool,
        unique: bool,
        references: option<foreign-key>,
        // Column default: the value a read resolves this column to when the row
        // has no value for it.
        //
        // Honoured by BOTH `create-table` and `add-column`. On `add-column` it
        // may also UPDATE the default of a column that already exists, provided
        // the name, column type and nullability all match; on any other
        // difference `add-column` still fails with "column already exists",
        // because that is a type/nullability conflict rather than a default.
        //
        // Setting or changing a default NEVER rewrites stored rows. A write that
        // omits the column records the default in force at that moment, so that
        // row keeps the old value if the default later changes. A row that
        // predates the column entirely has no value recorded and is resolved
        // against the current default on every read, so it does observe the
        // change. A row that SUPPLIED a value is unaffected either way.
        //
        // A column carrying a default is exempt from the not-null check even
        // when `nullable` is false — it cannot end up value-less — which makes
        // this the way to declare a required column. An explicitly supplied
        // null is a caller error, distinct from omitting the column.
        //
        // Literal values only; there are no expression defaults. A `counter`
        // column may not carry one: its value is read from its own cell, so a
        // default could never be observed (`constraint-violation`).
        default: option<value>,
        // Conflict-free counter column. Stored in its own cell rather than
        // inside the packed row, and mutated by an atomic add that registers no
        // read-conflict range — which is what lets concurrent increments
        // compose instead of conflicting at commit.
        //
        // A counter column cannot back an index: index maintenance needs the
        // previous value to remove the stale entry, and an atomic add never
        // reads one. The SDK's `Model` derive rejects that at compile time.
        counter: bool,
    }

    record column-info {
        name: string,
        col-type: column-type,
        nullable: bool,
    }

    /// Lightweight per-table introspection. Counts are derived metadata;
    /// callers who want full schema use list-columns / list-indexes.
    record table-info {
        name: string,
        column-count: u32,
        index-count: u32,
    }

    // Per-table encryption setting. An enum (not a bool) so future modes
    // (e.g. app-held keys) extend without changing the signature.
    //
    // DORMANT: encrypted tables are on hold. `none` is the default and the only
    // functional value; `enabled` is currently rejected by the host on every
    // engine (no backend implements encryption). The option is kept wired so the
    // feature can be revived without a WIT change. See
    // docs/superpowers/specs/2026-05-26-encrypted-tables-design.md.
    enum encryption-mode {
        none,       // plaintext at rest (default; today's behavior) — functional
        enabled,    // platform-managed encryption at rest — DORMANT, rejected today
    }

    // Options for create-table. A record so future options add fields,
    // not parameters.
    record create-table-options {
        encryption: encryption-mode,
    }

    create-table: func(
        table: string,
        columns: list<column-def>,
        options: create-table-options,
    ) -> result<_, store-error>;
    drop-table: func(table: string) -> result<_, store-error>;
    list-tables: func() -> result<list<table-info>, store-error>;

    record index-def {
        name: string,
        columns: list<string>,
        unique: bool,
        /// Covering index: the index entry stores a copy of the row payload, so
        /// an index walk reads the row directly from the index (no separate
        /// fetch). Trades write cost + storage for read speed on hot read paths.
        /// Defaults to `false`.
        covering: bool,
    }

    create-index: func(table: string, index: index-def) -> result<_, store-error>;
    drop-index: func(table: string, name: string) -> result<_, store-error>;
    list-indexes: func(table: string) -> result<list<index-def>, store-error>;

    /// A maintained rollup: per-group totals the platform keeps up to date as
    /// rows change, so `count`/`sum` over a declared grouping answer without
    /// reading the rows.
    ///
    /// Declared like an index — you state the access pattern, the platform
    /// picks the mechanism — and read through the ordinary `aggregate` call.
    /// There is no separate "read the rollup" verb and there deliberately is
    /// not one: a query either qualifies for the rollup or is computed, and
    /// which happened is not something the caller chooses or can observe in the
    /// answer.
    ///
    /// ## What it costs and when it pays
    ///
    /// One stored total per distinct value-tuple of `group`, updated on every
    /// insert, update and delete of the table. It pays when the same grouped
    /// total is read far more often than it changes, and when `group` has
    /// BOUNDED cardinality — grouping by a customer is bounded by customers,
    /// grouping by a request id is not. A `group` a unique index already
    /// declares distinct is rejected: one stored total per row can never cost
    /// less than reading the rows.
    ///
    /// ## Grouping by more than one column
    ///
    /// `group` is a LIST, and its order works exactly as a composite index's
    /// does — because it is the same mechanism, a tuple-ordered key:
    ///
    /// * a query may fix a leading PREFIX of the list by equality and group by
    ///   any prefix of what remains;
    /// * it may not fix a trailing column alone, because the matching totals are
    ///   scattered under every value of the ones before it.
    ///
    /// So `group = ["room-id", "post-id"]` answers "the totals per post in this
    /// room" and "the total for this room", and `["post-id", "room-id"]` answers
    /// neither. Choose the order the same way you would for an index: the
    /// column you filter on first.
    ///
    /// ## Reading a total inside a transaction
    ///
    /// Maintenance is conflict-free, but **reading** a total is an ordinary
    /// transactional read and takes a read-conflict range over the cells it
    /// touches — which are the cells every other writer is adding to. So a
    /// handler that bumps a total and then reads it back in the SAME
    /// transaction makes concurrent writers conflict, losing the property this
    /// whole mechanism exists to provide.
    ///
    /// Read a total inside a transaction only when you will DECIDE something
    /// with it, and then read it before you write. To report a total back to a
    /// caller, read it after the transaction commits.
    ///
    /// ## Constraints, all checked when you declare it
    ///
    /// * every `sum` column must be an integer column, and NOT NULL
    /// * every `group` and `sum` column must exist and not be a counter column
    /// * `group` must be non-empty and name no column twice
    /// * at least one of `sum`/`count` must be asked for
    ///
    /// The NOT NULL rule is the surprising one and it is a correctness rule,
    /// not a mechanical one: one stored total cannot distinguish "every value
    /// in this group was null", where `sum` is null, from "the values cancelled
    /// to zero", where it is 0. Refusing the declaration is what stops the same
    /// query answering differently depending on whether a rollup exists.
    ///
    /// Declaring one on a table that already holds rows counts them first, so
    /// the totals are correct from the moment it exists.
    record rollup-def {
        /// Identifies the rollup for `drop-rollup`. Not visible in results.
        name: string,
        /// The columns whose distinct value-tuples are the groups, in order.
        /// Order is the composite-index rule — see above.
        group: list<string>,
        /// Columns to total, by name.
        sum: list<string>,
        /// Also maintain the number of rows per group.
        ///
        /// Required in practice: a rollup that does not count cannot serve any
        /// query, because a group whose rows have all gone still holds a total
        /// of zero and only the count distinguishes that from a group that
        /// genuinely sums to zero.
        count: bool,
    }

    create-rollup: func(table: string, rollup: rollup-def) -> result<_, store-error>;
    drop-rollup: func(table: string, name: string) -> result<_, store-error>;
    list-rollups: func(table: string) -> result<list<rollup-def>, store-error>;

    /// A counter declared independently of any table: a conflict-free integer
    /// addressed by a key tuple the declaration names, rather than by a row.
    /// Distinct from a `column-def` with `counter = true`, whose cells are
    /// scoped by a column ordinal and a rowid — this one has no table, no
    /// rowid, and no column to hang off, so the declaration is what gives its
    /// cells a keyspace of their own.
    ///
    /// ## What it costs
    ///
    /// One cell per distinct value-tuple of `key-cols`, created lazily on
    /// first write. Unlike `rollup-def`, declaring a counter never backfills:
    /// a rollup counts a table's EXISTING rows so its totals are correct from
    /// the moment it exists, but a standalone counter has no rows to count —
    /// its cells are addressed by a key tuple the caller supplies on each
    /// read or write, not derived from anything already stored. So every key
    /// simply starts at zero, and declaring the counter is O(1) regardless of
    /// how much data already exists elsewhere in the tenant.
    ///
    /// ## The key tuple
    ///
    /// `key-cols` names the parts of the tuple that addresses one cell, in
    /// order — the caller supplies one value per name on every read or write,
    /// and the platform packs them into a key the same way a composite
    /// index's columns are packed. The names are labels for that tuple's
    /// positions, not references to any table's columns: a standalone counter
    /// has no table, so `key-cols = ["ip", "window"]` means "this counter's
    /// cell address is a 2-tuple, and here is what each position means,"
    /// nothing more.
    ///
    /// ## Constraints, all checked when you declare it
    ///
    /// * `name` must be a valid identifier, and must not already be declared
    /// * `key-cols` must be non-empty — a counter with no key addresses no
    ///   cell, which is never useful
    /// * every entry in `key-cols` must be a valid identifier
    record counter-def {
        /// Identifies the counter for lookup and for `list-counters`. Must be
        /// a valid identifier and unique among this tenant's counters.
        name: string,
        /// The columns whose value-tuple addresses one cell, in key order.
        /// Order matters exactly as it does for a composite index: a query may
        /// fix a leading prefix by equality, and cannot fix a trailing element
        /// alone. Must be non-empty, and every entry must be a valid
        /// identifier.
        key-cols: list<string>,
        /// Assigned by the store when declared. Monotonic per tenant, never
        /// reused — a dropped counter's cells can never be read back as a
        /// different counter's, because the next declaration always gets a
        /// fresh id.
        counter-id: u32,
    }

    /// Declare a counter and get back its allocated id. See `counter-def` for
    /// the full cost model and the constraints checked here — in short, fails
    /// with `constraint-violation` if `name` is already declared, is not a
    /// valid identifier, if `key-cols` is empty, or if any `key-cols` entry is
    /// not a valid identifier.
    create-counter: func(name: string, key-cols: list<string>) -> result<u32, store-error>;
    /// Every counter this tenant has declared.
    list-counters: func() -> result<list<counter-def>, store-error>;

    /// Add `delta` to a standalone counter's cell, addressed by `key` — one
    /// value per the declaration's `key-cols`, in the same order. The cell is
    /// created lazily at zero on first write; declaring the counter does not
    /// seed it.
    ///
    /// ## What it costs
    ///
    /// One native atomic add on the cell — it never reads the cell's current
    /// value, so it takes NO read-conflict range. Two concurrent
    /// `counter-add` calls against the SAME key, or against different keys of
    /// the same counter, never commit-conflict with each other: this is the
    /// entire reason the verb exists, as distinct from an ordinary
    /// read-modify-write increment.
    ///
    /// ## Constraints
    ///
    /// * `name` must already be declared via `create-counter` — otherwise
    ///   `not-found`
    /// * `key` must carry exactly as many values as the declaration's
    ///   `key-cols` — otherwise `constraint-violation`, naming both the
    ///   declared and the given arity
    counter-add: func(name: string, key: list<value>, delta: s64) -> result<_, store-error>;

    /// Read a standalone counter's current cell value. A cell nothing has
    /// ever added to reads as zero — a miss is not an error.
    ///
    /// `snapshot = true` takes NO read-conflict range: the read is cheap, but
    /// the value it returns is NOT safe to branch on inside a transaction —
    /// a concurrent `counter-add` against the same key can land after this
    /// read completes without the enclosing transaction ever finding out.
    /// `snapshot = false` takes the read-conflict range, so it IS safe to
    /// branch on: the enclosing transaction is forced to conflict (and
    /// retry) if another writer adds to this cell before it commits — at the
    /// cost of contending with concurrent `counter-add` calls the ordinary
    /// way.
    ///
    /// ## Constraints
    ///
    /// Same as `counter-add`: `name` must be declared (`not-found` if not),
    /// and `key`'s arity must match `key-cols` (`constraint-violation`,
    /// naming both arities, if not).
    counter-get: func(name: string, key: list<value>, snapshot: bool) -> result<s64, store-error>;

    /// Add a column, or set/update the `default` of one that already exists.
    ///
    /// On an existing column the call succeeds only when the name, column type
    /// and nullability all match; then the default is replaced (later write
    /// wins) and NOTHING IS BACKFILLED — see `column-def.default` for exactly
    /// which rows observe the change. Any other difference is a type or
    /// nullability conflict and still fails with `constraint-violation`
    /// ("column already exists").
    ///
    /// Re-adding an identically-shaped column is therefore idempotent, which is
    /// what lets a migration be re-run.
    add-column: func(table: string, column: column-def) -> result<_, store-error>;
    rename-column: func(table: string, old: string, new: string) -> result<_, store-error>;
    drop-column: func(table: string, name: string) -> result<_, store-error>;
    list-columns: func(table: string) -> result<list<column-info>, store-error>;

    // -- Raw SQL (parameterized) --
    execute: func(sql: string, params: list<value>) -> result<u64, store-error>;
    query: func(sql: string, params: list<value>) -> result<list<row>, store-error>;

    // -- Structured CRUD --
    insert: func(table: string, data: list<column>) -> result<u64, store-error>;
    insert-many: func(table: string, rows: list<list<column>>) -> result<list<u64>, store-error>;

    get: func(table: string, id: u64) -> result<option<row>, store-error>;
    // Batch get by primary key, pipelined host-side. One entry per id,
    // positional; a missing row is none.
    get-many: func(table: string, ids: list<u64>) -> result<list<option<row>>, store-error>;
    find: func(table: string, options: find-options) -> result<find-result, store-error>;
    // Batch of independent `find` queries (possibly different tables),
    // pipelined host-side in autocommit; sequential inside an ambient tx.
    // One find-result per query, positional.
    find-many: func(queries: list<find-query>) -> result<list<find-result>, store-error>;
    count: func(table: string, filters: list<filter>) -> result<u64, store-error>;
    // Aggregate over the rows `options.filters` selects, optionally grouped.
    //
    // How it is answered is the store's choice — seeking an index, folding the
    // matched rows, or reading a maintained rollup — and that choice is
    // deliberately not a parameter. Declare what you want to know; the store
    // decides how to find it.
    //
    // Read from ONE consistent snapshot: the whole walk runs in a single
    // transaction, so the answer reflects one state of the table rather than a
    // blend of several. Inside an open transaction it JOINS that transaction,
    // so a handler sees its own uncommitted writes.
    aggregate: func(table: string, options: aggregate-options)
        -> result<aggregate-result, store-error>;

    update: func(table: string, id: u64, fields: list<column>) -> result<bool, store-error>;
    update-where: func(table: string, filters: list<filter>, fields: list<column>) -> result<u64, store-error>;
    // Batch update/delete by primary key, pipelined host-side in one tx per
    // chunk. Return = count of rows that existed and were affected.
    update-many: func(table: string, updates: list<row-update>) -> result<u64, store-error>;
    delete-many: func(table: string, ids: list<u64>) -> result<u64, store-error>;

    /// The two column sets an upsert writes, distinguished by which arm runs.
    record upsert-columns {
        /// Written on BOTH arms — the row-creating one and every update after
        /// it. A non-empty `always` makes the update arm rewrite the whole row,
        /// so concurrent upserts of one row contend.
        always: list<column>,
        /// Written ONLY by the arm that creates the row. Counts toward the
        /// non-nullable coverage requirement and is never rewritten afterwards.
        /// Use it for a value the row needs at creation that must not be
        /// re-derived later — a computed `default`, where `default` itself can
        /// only be a static literal.
        on-insert: list<column>,
    }

    // Atomic keyed counter: `counter += delta` (delta must be integer or
    // real), upserting the row identified by the composite `key`. On first
    // call the row is inserted with `counter = delta` and the `columns.always`
    // + `columns.on-insert` columns; on subsequent calls the counter is
    // incremented and only `columns.always` is overwritten. Requires a unique
    // index on the `key` columns (the upsert conflict target). Returns the
    // row id.
    //
    // Because the first call INSERTS, `key ∪ always ∪ on-insert ∪ {counter}`
    // must cover every non-nullable column of the table that has no default,
    // or that call is refused with `constraint-violation` naming the missing
    // column. Later calls take the update arm and carry no such requirement.
    // A column listed in both `always` and `on-insert` is refused with
    // `constraint-violation` naming it.
    //
    // Prefer a `default` for a static value — that is the cheap fix, and
    // unlike either column list it does not get written through a row update
    // at all. Prefer `on-insert` for a computed value that must exist at
    // creation but should never be re-derived later. Reach for `always` only
    // for a value that must genuinely change on every call; a non-empty
    // `always` rewrites the whole row on every update, so seeding a second
    // counter with a literal zero there resets it each time instead of only
    // on creation.
    //
    // Never name a SECOND counter column in `always` or `on-insert`: the
    // insert arm merges `key`, `always` and `on-insert` before pushing this
    // call's own `(counter, delta)`, and the counter-cell write is
    // first-wins, so a literal for another counter placed there silently
    // wins over that counter's own first increment.
    upsert-increment: func(table: string, key: list<column>, counter: string, delta: value, columns: upsert-columns) -> result<u64, store-error>;

    /// Atomic insert-or-update keyed on a unique index. If a row exists
    /// whose `key` columns match (under a unique index that covers those
    /// columns; column order in the index doesn't matter), update
    /// `columns.always` on it (key columns untouched unless `always` also
    /// lists them, in which case `always` wins via field-merge). Otherwise
    /// insert a new row with `key + columns.always + columns.on-insert`.
    /// Returns the row id (existing or newly-inserted).
    ///
    /// PRECONDITION: the `key` columns must correspond to an existing
    /// unique index on the table. Otherwise the host errors with a
    /// SchemaMismatch identifying the missing index.
    ///
    /// A column listed in both `always` and `on-insert` is refused with
    /// `constraint-violation` naming it, the same refusal `upsert-increment`
    /// enforces on the identical collision.
    upsert: func(table: string, key: list<column>, columns: upsert-columns) -> result<u64, store-error>;

    delete: func(table: string, id: u64) -> result<bool, store-error>;
    delete-where: func(table: string, filters: list<filter>) -> result<u64, store-error>;

    // -- Transactions --
    //
    // `begin-transaction` opens an ambient transaction bound to THIS request.
    // While it is open, every store op below runs inside it (no per-op commit),
    // and any `peer::fetch` call enrolls the callee's whole subtree into the
    // SAME transaction. `commit-transaction` commits it (owner only); a failed
    // participant poisons the tx and commit then errors. `rollback-transaction`
    // (or dropping the request) discards it. `outbound-http` is denied while
    // a transaction is open. For `background-jobs`: `enqueue` is allowed —
    // the job is staged and submitted only if the transaction commits — but
    // `cancel` and `status` are denied inside a transaction. If the store
    // can't open a transaction it returns `unsupported`.
    begin-transaction:    func() -> result<_, store-error>;
    commit-transaction:   func() -> result<_, store-error>;
    rollback-transaction: func() -> result<_, store-error>;

    // -- Bounded-memory streaming cursor --
    //
    // `open-cursor` returns a stateless `row-cursor` over `table`,
    // applying `options.filters` + `options.or-groups` per row and
    // walking in `order`. `options.sort` / `options.page` are ignored
    // (the cursor's own `order` + `next-batch(max)` drive ordering and
    // batching). `column = none` walks primary-key (`_id`) order; a
    // `column` walks a keyset on `(column, _id)` over the secondary index
    // of that name.
    //
    // `next-batch(max)` returns the next ≤`max` rows, strictly AFTER
    // the previously-returned rows (exclusive resume), in `order`.
    // Looping until it returns an empty list visits every matching row
    // exactly once, in order, with no gaps or duplicates. An empty (or
    // short) batch with no more rows means exhausted; subsequent calls
    // keep returning empty.
    record scan-order {
        // none = primary-key (`_id`) order.
        column: option<string>,
        dir: sort-dir,
    }
    resource row-cursor {
        next-batch: func(max: u32) -> result<list<row>, store-error>;
    }
    open-cursor: func(table: string, options: find-options, order: scan-order) -> result<row-cursor, store-error>;
}

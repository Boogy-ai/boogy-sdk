package boogy:platform@0.1.0;

interface store {
    // -- Typed values --
    variant value {
        null,
        text(string),
        integer(s64),
        real(f64),
        blob(list<u8>),
        boolean(bool),
    }

    /// Errors a store operation can fail with. The `string` payload is
    /// for human consumption only — programmatic discrimination should
    /// use the variant arm. Mirrors peer.wit's `fetch-error`.
    variant store-error {
        quota-exceeded(string),
        not-found(string),
        conflict(string),
        constraint-violation(string),
        invalid-argument(string),
        unsupported(string),
        timeout(string),
        version-mismatch(string),
        /// Ambiguous commit (`commit_unknown_result`): the write MAY or MAY NOT
        /// have been applied. Do NOT blindly retry (could double-apply) —
        /// reconcile state first. → HTTP 409 (ambiguous-commit; distinct from a
        /// clean retryable conflict). The message body carries the distinction.
        commit-unknown(string),
        /// Transient: too many concurrent transactions; retry later. → HTTP 503.
        resource-exhausted(string),
        /// The transaction was rolled back because a participant failed. NOT a
        /// serialization conflict and NOT retryable — re-running would re-execute
        /// the participant that failed. → HTTP 409.
        poisoned(string),
        /// The transaction exhausted its retry attempts against a contended
        /// row. Transient: the caller should retry the request. → HTTP 503.
        too-contended(string),
        internal(string),
    }

    record column {
        name: string,
        val: value,
    }

    record row {
        columns: list<column>,
    }

    // One row's update in a batch `update-many`: the primary key + the columns to set.
    record row-update {
        id: u64,
        columns: list<column>,
    }

    // -- Filtering --
    enum filter-op {
        eq,
        neq,
        gt,
        gte,
        lt,
        lte,
        like,
        not-like,
        is-null,
        is-not-null,
        in,
    }

    record filter {
        column: string,
        op: filter-op,
        val: value,
        /// Only used when op == in. Contains the set of values to match against.
        in-values: option<list<value>>,
    }

    // -- Sorting & Pagination --
    enum sort-dir { asc, desc }

    record sort-by {
        column: string,
        dir: sort-dir,
    }

    record page {
        limit: u32,
        offset: u32,
    }

    record find-options {
        filters: list<filter>,
        sort: list<sort-by>,
        page: option<page>,
        /// OR-of-AND clause layered on top of `filters`. A row matches when
        /// ALL(filters) AND (or-groups is empty OR ANY(group: ALL(group))).
        /// Empty `or-groups` (the default) is exactly the filters-only
        /// behavior — fully backward compatible.
        or-groups: list<list<filter>>,
        /// Skip computing `total-count` (the host returns 0). Set by callers
        /// that discard the total — keyset/`fetch-page`, `fetch-all`,
        /// `fetch-one` — so the host can avoid the count entirely on the
        /// index-walk fast path, where it would otherwise be a separate count
        /// over the table for a value nobody reads. Defaults to `false` (the
        /// total is computed) — counts and total-bearing fetches leave it off.
        skip-total: bool,
    }

    record find-result {
        rows: list<row>,
        total-count: u64,
    }

    // One independent query in a batch `find-many`: a table + the same
    // find-options a single `find` takes.
    record find-query {
        table: string,
        options: find-options,
    }

    // -- Schema management --
    enum column-type { text, integer, real, blob, boolean }

    enum cascade-action {
        no-action,
        restrict,
        cascade,
        set-null,
    }

    record foreign-key {
        references-table: string,
        references-column: string,
        on-delete: cascade-action,
        on-update: cascade-action,
    }

    record column-def {
        name: string,
        col-type: column-type,
        // False = the column must always hold a value, and this is ENFORCED on
        // every write path, not merely recorded:
        //
        // - A write that CREATES a row (`insert`, `insert-many`, and the
        //   row-creating arm of `upsert` / `upsert-increment`) must supply the
        //   column. Both an explicitly supplied `value.null` and a plain
        //   omission are refused with `constraint-violation`.
        // - A write that AMENDS a row (`update`, `update-many`, `update-where`,
        //   and the update arm of either upsert) is a change set: an absent
        //   column means "leave it alone", so only an explicit null is refused.
        //
        // Omission is refused because it is not the same as a zero and not the
        // same as absence either — it is both at once. A row stored without a
        // value for a column reads that column back as the type's zero value,
        // but no index entry was written for it, so the same row is invisible to
        // any indexed query over that column. Present to a lookup, absent to a
        // seek, with nothing saying so.
        //
        // Consequence at the call site, and it is a real cost: `upsert-increment`
        // and `upsert` must have `key ∪ columns.always ∪ columns.on-insert`
        // (plus the counter) cover every non-nullable column that has no
        // default, because the first call for a key is the one that creates
        // the row. If a column has a sensible STATIC starting value, give it a
        // `default` — that is the cheap fix, and unlike either column list it
        // does not overwrite the column on every later call. If the value is
        // COMPUTED at call time (a timestamp, a derived id), `on-insert` is
        // the fix instead: written only by the row-creating call, never
        // rewritten after. Reach for `always` only when the value must
        // genuinely change on every call.
        //
        // Two exemptions, each because the column cannot end up value-less: a
        // column with a `default` (the engine materializes it into the row when
        // the write omits it) and a `counter` column (its value lives in its own
        // cell, and the row slot is left empty on purpose).
        nullable: bool,
        unique: bool,
        references: option<foreign-key>,
        // Column default: the value a read resolves this column to when the row
        // has no value for it.
        //
        // Honoured by BOTH `create-table` and `add-column`. On `add-column` it
        // may also UPDATE the default of a column that already exists, provided
        // the name, column type and nullability all match; on any other
        // difference `add-column` still fails with "column already exists",
        // because that is a type/nullability conflict rather than a default.
        //
        // Setting or changing a default NEVER rewrites stored rows. A write that
        // omits the column records the default in force at that moment, so that
        // row keeps the old value if the default later changes. A row that
        // predates the column entirely has no value recorded and is resolved
        // against the current default on every read, so it does observe the
        // change. A row that SUPPLIED a value is unaffected either way.
        //
        // A column carrying a default is exempt from the not-null check even
        // when `nullable` is false — it cannot end up value-less — which makes
        // this the way to declare a required column. An explicitly supplied
        // null is a caller error, distinct from omitting the column.
        //
        // Literal values only; there are no expression defaults. A `counter`
        // column may not carry one: its value is read from its own cell, so a
        // default could never be observed (`constraint-violation`).
        default: option<value>,
        // Conflict-free counter column. Stored in its own cell rather than
        // inside the packed row, and mutated by an atomic add that registers no
        // read-conflict range — which is what lets concurrent increments
        // compose instead of conflicting at commit.
        //
        // A counter column cannot back an index: index maintenance needs the
        // previous value to remove the stale entry, and an atomic add never
        // reads one. The SDK's `Model` derive rejects that at compile time.
        counter: bool,
    }

    record column-info {
        name: string,
        col-type: column-type,
        nullable: bool,
    }

    /// Lightweight per-table introspection. Counts are derived metadata;
    /// callers who want full schema use list-columns / list-indexes.
    record table-info {
        name: string,
        column-count: u32,
        index-count: u32,
    }

    // Per-table encryption setting. An enum (not a bool) so future modes
    // (e.g. app-held keys) extend without changing the signature.
    //
    // DORMANT: encrypted tables are on hold. `none` is the default and the only
    // functional value; `enabled` is currently rejected by the host on every
    // engine (no backend implements encryption). The option is kept wired so the
    // feature can be revived without a WIT change. See
    // docs/superpowers/specs/2026-05-26-encrypted-tables-design.md.
    enum encryption-mode {
        none,       // plaintext at rest (default; today's behavior) — functional
        enabled,    // platform-managed encryption at rest — DORMANT, rejected today
    }

    // Options for create-table. A record so future options add fields,
    // not parameters.
    record create-table-options {
        encryption: encryption-mode,
    }

    create-table: func(
        table: string,
        columns: list<column-def>,
        options: create-table-options,
    ) -> result<_, store-error>;
    drop-table: func(table: string) -> result<_, store-error>;
    list-tables: func() -> result<list<table-info>, store-error>;

    record index-def {
        name: string,
        columns: list<string>,
        unique: bool,
        /// Covering index: the index entry stores a copy of the row payload, so
        /// an index walk reads the row directly from the index (no separate
        /// fetch). Trades write cost + storage for read speed on hot read paths.
        /// Defaults to `false`.
        covering: bool,
    }

    create-index: func(table: string, index: index-def) -> result<_, store-error>;
    drop-index: func(table: string, name: string) -> result<_, store-error>;
    list-indexes: func(table: string) -> result<list<index-def>, store-error>;

    /// Add a column, or set/update the `default` of one that already exists.
    ///
    /// On an existing column the call succeeds only when the name, column type
    /// and nullability all match; then the default is replaced (later write
    /// wins) and NOTHING IS BACKFILLED — see `column-def.default` for exactly
    /// which rows observe the change. Any other difference is a type or
    /// nullability conflict and still fails with `constraint-violation`
    /// ("column already exists").
    ///
    /// Re-adding an identically-shaped column is therefore idempotent, which is
    /// what lets a migration be re-run.
    add-column: func(table: string, column: column-def) -> result<_, store-error>;
    rename-column: func(table: string, old: string, new: string) -> result<_, store-error>;
    drop-column: func(table: string, name: string) -> result<_, store-error>;
    list-columns: func(table: string) -> result<list<column-info>, store-error>;

    // -- Raw SQL (parameterized) --
    execute: func(sql: string, params: list<value>) -> result<u64, store-error>;
    query: func(sql: string, params: list<value>) -> result<list<row>, store-error>;

    // -- Structured CRUD --
    insert: func(table: string, data: list<column>) -> result<u64, store-error>;
    insert-many: func(table: string, rows: list<list<column>>) -> result<list<u64>, store-error>;

    get: func(table: string, id: u64) -> result<option<row>, store-error>;
    // Batch get by primary key, pipelined host-side. One entry per id,
    // positional; a missing row is none.
    get-many: func(table: string, ids: list<u64>) -> result<list<option<row>>, store-error>;
    find: func(table: string, options: find-options) -> result<find-result, store-error>;
    // Batch of independent `find` queries (possibly different tables),
    // pipelined host-side in autocommit; sequential inside an ambient tx.
    // One find-result per query, positional.
    find-many: func(queries: list<find-query>) -> result<list<find-result>, store-error>;
    count: func(table: string, filters: list<filter>) -> result<u64, store-error>;

    update: func(table: string, id: u64, fields: list<column>) -> result<bool, store-error>;
    update-where: func(table: string, filters: list<filter>, fields: list<column>) -> result<u64, store-error>;
    // Batch update/delete by primary key, pipelined host-side in one tx per
    // chunk. Return = count of rows that existed and were affected.
    update-many: func(table: string, updates: list<row-update>) -> result<u64, store-error>;
    delete-many: func(table: string, ids: list<u64>) -> result<u64, store-error>;

    /// The two column sets an upsert writes, distinguished by which arm runs.
    record upsert-columns {
        /// Written on BOTH arms — the row-creating one and every update after
        /// it. A non-empty `always` makes the update arm rewrite the whole row,
        /// so concurrent upserts of one row contend.
        always: list<column>,
        /// Written ONLY by the arm that creates the row. Counts toward the
        /// non-nullable coverage requirement and is never rewritten afterwards.
        /// Use it for a value the row needs at creation that must not be
        /// re-derived later — a computed `default`, where `default` itself can
        /// only be a static literal.
        on-insert: list<column>,
    }

    // Atomic keyed counter: `counter += delta` (delta must be integer or
    // real), upserting the row identified by the composite `key`. On first
    // call the row is inserted with `counter = delta` and the `columns.always`
    // + `columns.on-insert` columns; on subsequent calls the counter is
    // incremented and only `columns.always` is overwritten. Requires a unique
    // index on the `key` columns (the upsert conflict target). Returns the
    // row id.
    //
    // Because the first call INSERTS, `key ∪ always ∪ on-insert ∪ {counter}`
    // must cover every non-nullable column of the table that has no default,
    // or that call is refused with `constraint-violation` naming the missing
    // column. Later calls take the update arm and carry no such requirement.
    // A column listed in both `always` and `on-insert` is refused with
    // `constraint-violation` naming it.
    //
    // Prefer a `default` for a static value — that is the cheap fix, and
    // unlike either column list it does not get written through a row update
    // at all. Prefer `on-insert` for a computed value that must exist at
    // creation but should never be re-derived later. Reach for `always` only
    // for a value that must genuinely change on every call; a non-empty
    // `always` rewrites the whole row on every update, so seeding a second
    // counter with a literal zero there resets it each time instead of only
    // on creation.
    //
    // Never name a SECOND counter column in `always` or `on-insert`: the
    // insert arm merges `key`, `always` and `on-insert` before pushing this
    // call's own `(counter, delta)`, and the counter-cell write is
    // first-wins, so a literal for another counter placed there silently
    // wins over that counter's own first increment.
    upsert-increment: func(table: string, key: list<column>, counter: string, delta: value, columns: upsert-columns) -> result<u64, store-error>;

    /// Atomic insert-or-update keyed on a unique index. If a row exists
    /// whose `key` columns match (under a unique index that covers those
    /// columns; column order in the index doesn't matter), update
    /// `columns.always` on it (key columns untouched unless `always` also
    /// lists them, in which case `always` wins via field-merge). Otherwise
    /// insert a new row with `key + columns.always + columns.on-insert`.
    /// Returns the row id (existing or newly-inserted).
    ///
    /// PRECONDITION: the `key` columns must correspond to an existing
    /// unique index on the table. Otherwise the host errors with a
    /// SchemaMismatch identifying the missing index.
    ///
    /// A column listed in both `always` and `on-insert` is refused with
    /// `constraint-violation` naming it, the same refusal `upsert-increment`
    /// enforces on the identical collision.
    upsert: func(table: string, key: list<column>, columns: upsert-columns) -> result<u64, store-error>;

    delete: func(table: string, id: u64) -> result<bool, store-error>;
    delete-where: func(table: string, filters: list<filter>) -> result<u64, store-error>;

    // -- Transactions --
    //
    // `begin-transaction` opens an ambient transaction bound to THIS request.
    // While it is open, every store op below runs inside it (no per-op commit),
    // and any `peer::fetch` call enrolls the callee's whole subtree into the
    // SAME transaction. `commit-transaction` commits it (owner only); a failed
    // participant poisons the tx and commit then errors. `rollback-transaction`
    // (or dropping the request) discards it. `outbound-http` is denied while
    // a transaction is open. For `background-jobs`: `enqueue` is allowed —
    // the job is staged and submitted only if the transaction commits — but
    // `cancel` and `status` are denied inside a transaction. If the store
    // can't open a transaction it returns `unsupported`.
    begin-transaction:    func() -> result<_, store-error>;
    commit-transaction:   func() -> result<_, store-error>;
    rollback-transaction: func() -> result<_, store-error>;

    // -- Bounded-memory streaming cursor --
    //
    // `open-cursor` returns a stateless `row-cursor` over `table`,
    // applying `options.filters` + `options.or-groups` per row and
    // walking in `order`. `options.sort` / `options.page` are ignored
    // (the cursor's own `order` + `next-batch(max)` drive ordering and
    // batching). `column = none` walks primary-key (`_id`) order; a
    // `column` walks a keyset on `(column, _id)` over the secondary index
    // of that name.
    //
    // `next-batch(max)` returns the next ≤`max` rows, strictly AFTER
    // the previously-returned rows (exclusive resume), in `order`.
    // Looping until it returns an empty list visits every matching row
    // exactly once, in order, with no gaps or duplicates. An empty (or
    // short) batch with no more rows means exhausted; subsequent calls
    // keep returning empty.
    record scan-order {
        // none = primary-key (`_id`) order.
        column: option<string>,
        dir: sort-dir,
    }
    resource row-cursor {
        next-batch: func(max: u32) -> result<list<row>, store-error>;
    }
    open-cursor: func(table: string, options: find-options, order: scan-order) -> result<row-cursor, store-error>;
}
